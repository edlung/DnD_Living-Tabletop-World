      "knowledgeId": "kerra-stair",
      "scope": { "kind": "NPC", "npcId": "kerra-reed" },
      "knowledgeType": "SECRET",
      "statement": "The way down lies under the cracked slab before the chapel altar: press the carved bell.",
      "subjects": ["feature-f3c7a185", "drowned-chapel"],
      "knownSince": -1699200
    },
    {
