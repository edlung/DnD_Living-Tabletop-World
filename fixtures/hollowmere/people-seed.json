  "commands": [
    {
      "type": "AddKnowledge",
      "knowledgeId": "pub-hollowmere",
      "scope": { "kind": "PUBLIC" },
      "knowledgeType": "FACT",
      "statement": "Hollowmere is a village of reed-cutters and eel-fishers at the edge of the Fogmarsh, a day’s ride north of Ravenford by the Mill Road.",
      "subjects": ["hollowmere", "mill-road", "fogmarsh"],
      "knownSince": null
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "pub-bell-rumour",
      "scope": { "kind": "PUBLIC" },
      "knowledgeType": "RUMOR",
      "statement": "Folk say the bell of Hollowmere rang at midnight three nights running, with no one at the rope.",
      "subjects": ["hollowmere-bell", "hollowmere"],
      "knownSince": -144000
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "pub-chapel-flood",
      "scope": { "kind": "PUBLIC" },
      "knowledgeType": "FACT",
      "statement": "The Drowned Chapel has stood half under water since the great flood thirty years ago.",
      "subjects": ["drowned-chapel", "fogmarsh"],
      "knownSince": null
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "pub-ford-goblins",
      "scope": { "kind": "PUBLIC" },
      "knowledgeType": "RUMOR",
      "statement": "Goblins have come down from the hills to rob carts at the Willow Ford.",
      "subjects": ["willow-ford", "mill-road"],
      "knownSince": -403200
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "party-brisk-hire",
      "scope": { "kind": "PARTY" },
      "knowledgeType": "FACT",
      "statement": "Agna Brisk hired us to take her wagon of lamp-oil and salt to Hollowmere, and to learn why its reeve has stopped writing.",
      "subjects": ["brisk-cargo", "agna-brisk", "hollowmere", "hobb-fenwick"],
      "knownSince": 28800
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "agna-letters",
      "scope": { "kind": "NPC", "npcId": "agna-brisk" },
      "knowledgeType": "FACT",
      "statement": "Reeve Fenwick wrote every month for oil. His last letter, a month ago, spoke of the bell and asked for a priest.",
      "subjects": ["hobb-fenwick", "hollowmere-bell"],
      "knownSince": -2563200
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "hobb-bell",
      "scope": { "kind": "NPC", "npcId": "hobb-fenwick" },
      "knowledgeType": "TESTIMONY",
      "statement": "The bell rang at midnight three nights running. Old Matthis, the ringer, went up to watch it on the third night and has not come back.",
      "subjects": ["hollowmere-bell", "old-matthis", "bell-tower"],
      "attributedTo": "hobb-fenwick",
      "knownSince": -57600
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "hobb-cellar",
      "scope": { "kind": "NPC", "npcId": "hobb-fenwick" },
      "knowledgeType": "FACT",
      "statement": "Something has been eating the salt and the oil in the hall’s cellar, and nobody will go down there now.",
      "subjects": ["reeves-cellar"],
      "knownSince": -230400
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "hobb-silver",
      "scope": { "kind": "NPC", "npcId": "hobb-fenwick" },
      "knowledgeType": "SECRET",
      "statement": "Hobb takes a share of the silver the Reed Cloaks pay to land their boats at Hollowmere, and keeps quiet about their night trips into the marsh.",
      "subjects": ["faction-3d7a52e8", "hobb-fenwick"],
      "knownSince": null
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "ilse-saint",
      "scope": { "kind": "NPC", "npcId": "sister-ilse" },
      "knowledgeType": "TESTIMONY",
      "statement": "Saint Odran was a knight who drowned holding back the flood. His bell was sunk with him beneath the chapel, and it must never be rung.",
      "subjects": ["drowned-chapel"],
      "attributedTo": "sister-ilse",
      "knownSince": null
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "ilse-lights",
      "scope": { "kind": "NPC", "npcId": "sister-ilse" },
      "knowledgeType": "TESTIMONY",
      "statement": "Lights move at the Drowned Chapel at night, and boats go out to it with no lanterns lit.",
      "subjects": ["drowned-chapel", "feature-b57d2e3a"],
      "attributedTo": "sister-ilse",
      "knownSince": -316800
    },
    {
      "type": "AddKnowledge",
      "knowledgeId": "ilse-matthis",
      "scope": { "kind": "NPC", "npcId": "sister-ilse" },
      "knowledgeType": "FACT",
      "statement": "Old Matthis went to the bell tower on the third night with a lantern and a cudgel.",
      "subjects": ["old-matthis", "bell-tower"],
      "knownSince": -57600
    },
    {
