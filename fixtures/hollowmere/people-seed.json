      "scope": { "kind": "NPC", "npcId": "kerra-reed" },
      "knowledgeType": "SECRET",
      "statement": "A hooded lantern-bearer pays the Reed Cloaks in silver to carry the dead, and the living, to the stair beneath the chapel.",
