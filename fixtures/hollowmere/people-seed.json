      "scope": { "kind": "NPC", "npcId": "old-matthis" },
      "knowledgeType": "TESTIMONY",
      "statement": "The hooded one makes me ring the old bell down here, and every time it rings, the knight in the pool stirs.",
      "subjects": ["npc-7c3e91a2", "feature-6e0a4bd2", "creature-2e3554f3"],
      "attributedTo": "old-matthis",
      "knownSince": -57600
    },
    {
