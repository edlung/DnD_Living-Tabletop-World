# deploy/.env: the settings and secrets of one deployment (docs/adr/0037-deployment.md).
# Copy this file to deploy/.env (git-ignored; chmod 600) and fill it in on the server. Names only
# here: never commit values. Empty means "the default named in the comment" or "not used".
# The server container receives every variable in this file; NODE_ENV=production,
# AUTH_MODE=invitations and its database address are fixed by compose.yaml.

# Images to run: the 12-character git revision deploy/scripts/build.sh printed. deploy.sh sets
# both; the previous one is what a rollback returns to.
LTW_IMAGE_TAG=
LTW_PREVIOUS_IMAGE_TAG=
# true only while rolling back onto a database a newer image migrated (deploy.sh --rollback).
LTW_ALLOW_NEWER_SCHEMA=
# Written by deploy.sh: the digest of the networks last deployed (a change recreates every
# container).
LTW_NETWORKS_DIGEST=

# The public address: the domain (or localhost for local verification) and its origin, exactly
# https://<PUBLIC_HOST> (with :<port> when the HTTPS port is not 443; no trailing slash).
# Invitation sign-in requires it (links, the cookie, the origin check; ADR 0036).
PUBLIC_HOST=
PUBLIC_ORIGIN=
# acme: a public domain, automatic certificates and HSTS. internal: local verification only.
TLS_MODE=
# Published proxy ports as [address:]port. Defaults 80 and 443 on every interface.
PROXY_HTTP_PUBLISH=
PROXY_HTTPS_PUBLISH=
# The proxy-to-server network `backend`, as its first three octets (default 10.231.251): the
# range <prefix>.0/24, the server at <prefix>.10, the proxy within <prefix>.128/25. The server
# listens only there and trusts X-Forwarded-For from that range alone (LTW_TRUST_PROXY, set by
# compose). Change it only if it collides with a network of this host.
LTW_BACKEND_PREFIX=

# Database password: hexadecimal only (openssl rand -hex 32); it is part of the server's
# connection URL. Changing it later needs the rotation steps of the runbook.
POSTGRES_PASSWORD=

# Backups: an absolute host directory writable by uid 70, outside the repository.
BACKUP_DIR=
# Defaults: every 21600 s (6 h), the newest of 14 days and of 8 ISO weeks.
BACKUP_INTERVAL_SECONDS=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=

# Live AI (ADR 0032): provider keys, the per-capability routes and the operator's approval.
# Empty: every capability stays local. Spending ceilings are operator records, never settings.
ANTHROPIC_API_KEY=
LTW_AI_ROUTES=
LTW_AI_APPROVAL_ID=
# Images in play (Stage 330, ADR 0035): the OpenRouter key; empty: no image provider call.
OPENROUTER_API_KEY=

# Quest definitions the server reads (ADR 0025 §2). Empty: the Russian Ravenford's, which the
# review campaign uses (/app/fixtures/ravenford-ru/quests.json in the image).
LTW_QUESTS_FILE=

# Alarms of deploy/scripts/watch.sh (run on the host): optional webhook receiving alarm lines.
ALARM_WEBHOOK_URL=

# Memory limits per container. Defaults: server 1g, postgres 1g, proxy 256m, backup 512m.
SERVER_MEMORY=
POSTGRES_MEMORY=
PROXY_MEMORY=
BACKUP_MEMORY=
