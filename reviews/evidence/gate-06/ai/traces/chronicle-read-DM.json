c49bbc0b-86d7-4b1e-b850-a4291f596601","paragraphs":[{"text":"На Рыночной площади Мира Вейл рассказала Эловену Старвиспер и остальным, что караван ушёл до рассвета. Это лишь её слова, подтверждений им в записях нет.","cites":["e1"]},{"text":"Мы решили искать караван на Старой Торговой дороге.","cites":["e2"]},{"text":"Из-за этого решения мы закупили припасы в дорогу.","cites":["e3"]}]}},{"chronicleId":"chronicle.79129eb2-5592-444b-8766-2ba54a2b1502","title":"Хроника DM","perspective":"DM","from":0,"to":36000,"generatedAt":36000,"entries":[{"key":"e1","occurredAt":32400,"text":"Новое лицо в истории: Мира Вейл.","salience":3,"memoryId":null,"memoryKind":null,"eventType":"EntityCreated","location":null,"participants":[{"entityId":"mira-vale","kind":"npc","name":"Мира Вейл"}],"knowledge":[],"sources":[{"eventId":"fed19fcc-e3f3-49c8-a7b8-1aa271f5cf89","eventType":"EntityCreated","sequence":10}]},{"key":"e2","occurredAt":32400,"text":"Новое лицо в истории: Орин Стоунберд.","salience":3,"memoryId":null,"memoryKind":null,"eventType":"EntityCreated","location":null,"participants":[{"entityId":"orin-stonebeard","kind":"npc","name":"Орин Стоунберд"}],"knowledge":[],"sources":[{"eventId":"720010ce-5612-461b-8041-d9ee229c2565","eventType":"EntityCreated","sequence":12}]},{"key":"e3","occurredAt":32400,"text":"Новое лицо в истории: Капитан Торн.","salience":3,"memoryId":null,"memoryKind":null,"eventType":"EntityCreated","location":null,"participants":[{"entityId":"captain-thorne","kind":"npc","name":"Капитан Торн"}],"knowledge":[],"sources":[{"eventId":"d7b47946-b18a-434d-ac2d-8bb99d7fe66f","eventType":"EntityCreated","sequence":14}]},{"key":"e4","occurredAt":32400,"text":"Перемещение: Эловен Старвиспер → Рыночная площадь.","salience":3,"memoryId":null,"memoryKind":null,"eventType":"EntityPlaced","location":{"entityId":"market-square","kind":"location","name":"Рыночная площадь"},"participants":[{"entityId":"elowen-starwhisper","kind":"character","name":"Эловен Старвиспер"}],"knowl