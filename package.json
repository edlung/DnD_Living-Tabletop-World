{
  "name": "living-tabletop-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint-parts.ts",
    "typecheck": "tsc -p tsconfig.json",
    "context-budget": "node scripts/context-budget/cli.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @ltw/web run build",
    "clean": "tsc -b tsconfig.build.json --clean",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ltw/server run db:migrate",
    "seed:ravenford": "pnpm --filter @ltw/server run seed:ravenford",
    "campaigns:endurance": "python3 scripts/campaign-endurance/audit.py",
    "campaigns:defeats": "python3 scripts/campaign-defeats/audit.py",
    "campaigns:balance": "python3 scripts/campaign-balance/audit.py",
    "campaigns:rehearse": "node --conditions=@ltw/source scripts/campaign-rehearsal/run.mjs",
    "adventures:build": "node --conditions=@ltw/source scripts/adventures/hollowmere/build.ts",
    "dev:server": "pnpm --filter @ltw/server run dev",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run context-budget && pnpm run test && pnpm run build && pnpm run db:migrate && pnpm run seed:ravenford && pnpm run test:integration && pnpm run test:e2e",
    "validate:ci-local": "bash scripts/ci-local.sh",
    "dev:web": "pnpm --filter @ltw/web run dev",
    "test:e2e": "playwright test",
    "evidence:screens": "playwright test -c playwright.evidence.config.ts",
    "eval:ai": "node --conditions=@ltw/source apps/server/src/testing/eval/eval-cli.ts",
    "ai:operator": "pnpm --filter @ltw/server run ai:operator",
    "auth:operator": "pnpm --filter @ltw/server run auth:operator",
    "workshop:operator": "pnpm --filter @ltw/server run workshop:operator",
    "images:smoke": "node --conditions=@ltw/source apps/server/src/testing/image-smoke.ts",
    "lighthouse:play": "node scripts/lighthouse/play-table.ts",
    "lighthouse:build": "node --conditions=@ltw/source scripts/lighthouse/build.ts",
    "lighthouse:book": "node --conditions=@ltw/source scripts/lighthouse/render.ts",
    "lighthouse:art": "node --input-type=module -e \"import('./scripts/lighthouse/assets.ts').then(m => m.prepareAssets())\"",
    "lighthouse:check": "vitest run --project unit scripts/lighthouse",
    "lighthouse:import-art": "node --conditions=@ltw/source scripts/lighthouse/import-art.ts",
    "acorn:build": "node --conditions=@ltw/source scripts/acorn-express/build.ts",
    "acorn:book": "node --conditions=@ltw/source scripts/acorn-express/render.ts",
    "acorn:art": "node --input-type=module -e \"import('./scripts/acorn-express/assets.ts').then(m => m.prepareAssets())\"",
    "acorn:check": "vitest run --project unit scripts/acorn-express",
    "acorn:import-art": "node --conditions=@ltw/source scripts/acorn-express/import-art.ts",
    "pearl:build": "node --conditions=@ltw/source scripts/moon-pearl/build.ts",
    "pearl:book": "node --conditions=@ltw/source scripts/moon-pearl/render.ts",
    "pearl:art": "node --input-type=module -e \"import('./scripts/moon-pearl/assets.ts').then(m => m.prepareAssets())\"",
    "pearl:check": "vitest run --project unit scripts/moon-pearl",
    "pearl:import-art": "node --conditions=@ltw/source scripts/moon-pearl/import-art.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
