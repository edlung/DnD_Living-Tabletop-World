{
  "name": "living-tabletop-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "context-budget": "node scripts/context-budget/cli.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @ltw/web run build",
    "clean": "tsc -b tsconfig.build.json --clean",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ltw/server run db:migrate",
    "seed:ravenford": "pnpm --filter @ltw/server run seed:ravenford",
    "dev:server": "pnpm --filter @ltw/server run dev",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run context-budget && pnpm run test && pnpm run build && pnpm run db:migrate && pnpm run seed:ravenford && pnpm run test:integration && pnpm run test:e2e",
    "validate:ci-local": "bash scripts/ci-local.sh",
    "dev:web": "pnpm --filter @ltw/web run dev",
    "test:e2e": "playwright test",
    "evidence:screens": "playwright test -c playwright.evidence.config.ts",
    "eval:ai": "node --conditions=@ltw/source apps/server/src/testing/eval/eval-cli.ts",
    "ai:operator": "pnpm --filter @ltw/server run ai:operator",
    "auth:operator": "pnpm --filter @ltw/server run auth:operator",
    "images:smoke": "node --conditions=@ltw/source apps/server/src/testing/image-smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
