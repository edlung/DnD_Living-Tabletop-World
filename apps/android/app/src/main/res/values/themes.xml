<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LTW" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/Theme.LTW.Dialog</item>
    </style>

    <style name="Theme.LTW.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:buttonBarButtonStyle">@style/LTW.DialogButton</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <!-- The client's buttons say their words as written, never in capitals. -->
    <style name="LTW.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.LTW.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LTW</item>
    </style>

    <style name="LTW.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/button_plain</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="LTW.Button.Primary">
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_primary</item>
    </style>

    <style name="LTW.Button.Quiet">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:background">@drawable/button_quiet</item>
    </style>
</resources>
