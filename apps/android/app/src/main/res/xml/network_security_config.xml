<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds play only on https servers (docs/adr/0070-native-apps.md §1, §8). A server on
     the DM's laptop (docs/adr/0061-local-mode.md §3) is trusted through the root its owner
     installed on this device as a CA certificate; the public server through the system's roots
     alone, so no installed root ever vouches for it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">vardahei.tech</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
