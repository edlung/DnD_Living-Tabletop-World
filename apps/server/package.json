{
  "name": "@ltw/server",
  "version": "0.0.0",
  "private": true,
  "description": "Modular-monolith server: composition root, HTTP API, persistence, and platform services.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --conditions=@ltw/source --watch src/main.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/platform/db/migrate-cli.js",
    "seed:ravenford": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/world-engine/seed-ravenford-cli.js",
    "ai:operator": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/ai/accounting/operator-cli.js",
    "auth:operator": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/auth/operator-cli.js"
  },
  "dependencies": {
    "@ltw/ai": "workspace:*",
    "@ltw/combat": "workspace:*",
    "@ltw/context": "workspace:*",
    "@ltw/contracts": "workspace:*",
    "@ltw/domain": "workspace:*",
    "@ltw/rules": "workspace:*",
    "fastify": "~5.12.5",
    "pg": "^8.23.1",
    "pino": "~10.3.1",
    "sharp": "0.34.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
