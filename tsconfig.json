{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Whole-repository typecheck (sources, tests, scripts, tool configs). Emits nothing; builds use tsconfig.build.json.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@ltw/source"],
    "resolveJsonModule": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
