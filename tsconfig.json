{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Whole-repository typecheck (sources, tests, scripts, tool configs). Emits nothing; builds use tsconfig.build.json.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "customConditions": ["@ltw/source"],
    "resolveJsonModule": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
